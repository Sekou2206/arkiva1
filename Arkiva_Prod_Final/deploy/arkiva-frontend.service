[Unit]
Description=Arkiva Next.js Frontend
After=network.target arkiva-backend.service

[Service]
User=arkiva
Group=arkiva
WorkingDirectory=/opt/arkiva1/Arkiva_Prod/frontend
Environment=NODE_ENV=production
Environment=NEXT_PUBLIC_API_URL=https://DOMAIN_A_CONFIGURER/api
ExecStart=/usr/bin/npm run start -- -H 127.0.0.1 -p 3000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
