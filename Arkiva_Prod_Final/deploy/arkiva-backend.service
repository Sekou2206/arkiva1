[Unit]
Description=Arkiva FastAPI Backend (Gunicorn)
After=network.target postgresql.service

[Service]
User=arkiva
Group=arkiva
WorkingDirectory=/opt/arkiva1/Arkiva_Prod/backend
EnvironmentFile=/opt/arkiva1/Arkiva_Prod/.env
ExecStart=/opt/arkiva1/Arkiva_Prod/backend/venv/bin/gunicorn -w 4 -k uvicorn.workers.UvicornWorker main:app -b 127.0.0.1:8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
