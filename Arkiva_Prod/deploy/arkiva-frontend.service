[Unit]
Description=Arkiva Next.js Frontend
After=network.target arkiva-backend.service

[Service]
User=arkiva
Group=arkiva
WorkingDirectory=/var/www/arkiva/frontend
Environment=NODE_ENV=production
Environment=NEXT_PUBLIC_API_URL=https://DOMAIN_A_CONFIGURER/api
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
